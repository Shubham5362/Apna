# Apna Mandla Environment Variables

# Backend Configurations
PROJECT_NAME="Apna Mandla API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# CORS
# For development, allow all. In production, change to specific domains.
BACKEND_CORS_ORIGINS=["*"]

# Database (PostgreSQL)
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=apnamandla
POSTGRES_PORT=5432
# If DATABASE_URL is provided, it takes precedence. Note the sync driver.
# DATABASE_URL=postgresql://postgres:postgres@db:5432/apnamandla

# Cache (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT Authentication Architecture
JWT_SECRET=supersecretkeychangeitforproduction
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days
